<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F6">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_avatar" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvHomeUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello User!"
                        android:textColor="#333"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Where do you want to go?"
                        android:textColor="#E57373"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notification"
                        app:tint="#333333" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:padding="20dp">

                <com.example.project_bus.ui.widgets.InstantAutoCompleteTextView
                    android:id="@+id/actvHomeOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_white"
                    android:hint="Boarding From"
                    android:paddingStart="20dp"
                    android:paddingEnd="60dp"
                    android:textSize="14sp"
                    android:inputType="textCapSentences"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.example.project_bus.ui.widgets.InstantAutoCompleteTextView
                    android:id="@+id/actvHomeDestination"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_white"
                    android:hint="Where are you going?"
                    android:paddingStart="20dp"
                    android:paddingEnd="60dp"
                    android:textSize="14sp"
                    android:inputType="textCapSentences"
                    app:layout_constraintTop_toBottomOf="@id/actvHomeOrigin"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageButton
                    android:id="@+id/btnHomeSwapLocations"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_swap_circle"
                    android:src="@drawable/ic_swap_vertical"
                    android:padding="10dp"
                    android:elevation="10dp"
                    android:outlineProvider="none"
                    app:tint="#FFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/actvHomeOrigin"
                    app:layout_constraintBottom_toTopOf="@id/actvHomeDestination"
                    app:layout_constraintEnd_toEndOf="@id/actvHomeOrigin"
                    android:layout_marginEnd="20dp" />

                <LinearLayout
                    android:id="@+id/rowDateSelection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/actvHomeDestination">

                    <TextView
                        android:id="@+id/btnHomeDateToday"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_date_btn_selected"
                        android:gravity="center"
                        android:text="Today"
                        android:textColor="#FFF"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/btnHomeDateTomorrow"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_date_btn_unselected"
                        android:gravity="center"
                        android:text="Tomorrow"
                        android:textColor="#FFF"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp"/>

                    <LinearLayout
                        android:id="@+id/btnHomeDateOther"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_date_btn_unselected"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="#FFF"/>
                        <TextView
                            android:id="@+id/tvHomeDateOtherText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Other"
                            android:layout_marginStart="4dp"
                            android:textColor="#FFF"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnHomeFindBus"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_btn_find_bus"
                    android:text="Find Buses"
                    android:textAllCaps="false"
                    android:textColor="#D50000"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    app:layout_constraintTop_toBottomOf="@id/rowDateSelection"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:text="Your Bookings"
                android:textColor="#0D1B2A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHomeBookingHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_booking"/>

            <TextView
                android:id="@+id/tvHomeNoHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No upcoming journeys booked."
                android:gravity="center"
                android:visibility="gone"
                android:textColor="#777"
                android:padding="20dp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_white">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home"
                app:tint="#D50000" />
        </FrameLayout>

        <ImageView
            android:id="@+id/navTicket"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginHorizontal="30dp"
            android:src="@drawable/ic_ticket"
            app:tint="#FF8A80" />

        <ImageView
            android:id="@+id/navWallet"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginHorizontal="30dp"
            android:src="@drawable/ic_wallet"
            app:tint="#FF8A80" />

        <ImageView
            android:id="@+id/navSettings"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginHorizontal="20dp"
            android:src="@drawable/ic_settings"
            app:tint="#FF8A80" />
    </LinearLayout>
</RelativeLayout>
