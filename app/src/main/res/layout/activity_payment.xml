<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pink">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvUserAvatar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/user_avatar"
                        android:contentDescription="@string/desc_user_avatar"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvUserName"
                        android:text="@string/hello_user"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="@string/subtitle_choose_seat"
                        android:textColor="#E57373"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginEnd="10dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_back"
                        android:layout_gravity="center"
                        android:contentDescription="@string/desc_back"
                        app:tint="#333"/>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnNotification"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input_field">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_notification"
                        android:layout_gravity="center"
                        android:contentDescription="@string/desc_notification"
                        app:tint="#333"/>
                </FrameLayout>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/cardJourneyInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_red_rounded_box"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBusName"
                        android:text="@string/bus_name_perera"
                        android:textColor="#FFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvBusType"
                        android:text="@string/type_ac_sleeper"
                        android:textColor="#EEE"
                        android:textSize="12sp"
                        android:layout_marginBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvBusTime"
                        android:text="@string/time_range_1"
                        android:textColor="#EEE"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="60dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/bus_booking"
                    android:contentDescription="@string/desc_bus_route"/>
            </RelativeLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:text="@string/title_credit_card"
                        android:textColor="#333"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dashed_border"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:text="@string/label_payment_method"
                            android:textColor="#333"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginEnd="16dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_mastercard"
                                android:layout_marginEnd="8dp"
                                tools:ignore="ContentDescription"/>

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_visa"
                                android:layout_marginEnd="8dp"
                                tools:ignore="ContentDescription"/>

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_amex"
                                android:layout_marginEnd="8dp"
                                tools:ignore="ContentDescription"/>

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_discover"
                                tools:ignore="ContentDescription"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:text="@string/label_name_on_card"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:layout_marginBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/etCardName"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/bg_white_rounded_12dp"
                        android:backgroundTint="#FFF"
                        android:hint="@string/hint_name_sample"
                        android:textSize="14sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.AppCompat.EditText"/> <TextView
                    android:text="@string/label_card_number"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#333"
                    android:layout_marginBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/etCardNumber"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/bg_outline_white"
                        android:backgroundTint="#EEE"
                        android:hint="@string/hint_card_sample"
                        android:textSize="14sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="number"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:orientation="vertical"
                            android:layout_marginEnd="16dp">
                            <TextView
                                android:text="@string/label_expiration"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#333"
                                android:layout_marginBottom="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/tvExpMonth"
                                    android:layout_width="0dp"
                                    android:layout_height="45dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_outline_white"
                                    android:backgroundTint="#EEE"
                                    android:gravity="center_vertical"
                                    android:text="@string/hint_month"
                                    android:paddingStart="10dp"
                                    android:textSize="13sp"
                                    android:drawableEnd="@drawable/ic_arrow_down"
                                    android:drawablePadding="4dp"
                                    android:layout_marginEnd="8dp"/>
                                <TextView
                                    android:id="@+id/tvExpYear"
                                    android:layout_width="0dp"
                                    android:layout_height="45dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_outline_white"
                                    android:backgroundTint="#EEE"
                                    android:gravity="center_vertical"
                                    android:text="@string/hint_year"
                                    android:paddingStart="10dp"
                                    android:textSize="13sp"
                                    android:drawableEnd="@drawable/ic_arrow_down"/>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:orientation="vertical">
                            <TextView
                                android:text="@string/label_security_code"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#333"
                                android:layout_marginBottom="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <EditText
                                android:id="@+id/etCvv"
                                android:layout_width="match_parent"
                                android:layout_height="45dp"
                                android:background="@drawable/bg_outline_white"
                                android:backgroundTint="#EEE"
                                android:hint="@string/hint_code"
                                android:textSize="14sp"
                                android:paddingHorizontal="12dp"
                                android:inputType="numberPassword"
                                android:drawableEnd="@drawable/ic_help"
                                android:drawableTint="#999"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPayNow"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_red_button"
                android:text="@string/btn_pay_now"
                android:textAllCaps="false"
                android:textColor="#FFF"
                android:textStyle="bold"
                android:textSize="16sp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="25dp"
            android:src="@drawable/ic_home"
            android:contentDescription="@string/desc_home"
            app:tint="#FF8A80"/>

        <FrameLayout
            android:id="@+id/navTicket"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_field">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ticket"
                android:contentDescription="@string/desc_ticket"
                app:tint="@color/brand_red"/>
        </FrameLayout>

        <ImageView
            android:id="@+id/navWallet"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="25dp"
            android:src="@drawable/ic_wallet"
            android:contentDescription="@string/desc_wallet"
            app:tint="#FF8A80"/>

        <ImageView
            android:id="@+id/navSettings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="20dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/desc_settings"
            app:tint="#FF8A80"/>
    </LinearLayout>

</RelativeLayout>